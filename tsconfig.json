{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "tools/**/*.ts", "vite.config.ts"]
}
